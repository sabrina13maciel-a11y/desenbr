# Configuração de Ambiente - Exemplo
# Copie este arquivo para .env e configure suas variáveis

# Porta da aplicação (padrão: 5000)
PORT=5000

# Chave secreta da aplicação  
SESSION_SECRET=your-secret-key-here

# URL do banco de dados PostgreSQL
DATABASE_URL=postgresql://user:password@localhost/dbname

# Gateway de Pagamento HurionPay
HURIONPAY_PUBLIC_KEY=your_hurionpay_public_key
HURIONPAY_SECRET_KEY=your_hurionpay_secret_key

# Gateway alternativo FlevoPay / GhostsPay (opcional)
FLEVOPAY_SECRET_KEY=your_flevopay_secret_key
GHOSTSPAY_SECRET_KEY=your_ghostspay_secret_key

# Modo de debug (padrão: False)
FLASK_DEBUG=False

# Exemplos de portas customizadas:
# PORT=3000    # Para desenvolvimento
# PORT=8080    # Para testes
# PORT=80      # Para produção HTTP
# PORT=443     # Para produção HTTPS